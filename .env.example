# Copia a .env para desarrollo local. NUNCA subas el .env real.
ENVIRONMENT=development

# Debe coincidir con el SECRET_KEY de inventory-be: este servicio valida
# los tokens que aquel emite.
SECRET_KEY=cambiame
ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory

# Vacio en local: las imagenes no se guardan y la prediccion funciona igual
BUCKET_IMAGENES=
AWS_REGION=us-east-1

UMBRAL_CONFIANZA=0.60
TAMANO_MAXIMO_MB=5
